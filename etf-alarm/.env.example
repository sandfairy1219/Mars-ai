# Discord Webhook URL
# 채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
# 기본 웹훅: 모든 소스가 이 URL로 전송됨 (소스별 웹훅 미설정 시)
DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/1504492753189343333/H0n_lrsuxwM1VuMeBPGDWMZFLfBKueiSPqomh3y4rlWYKXLryVnX1U11ORC9h0ZwWoSq

# 체크 주기 (분 단위, 기본: 10)
CHECK_INTERVAL_MINUTES=10

# ==========================================
# 크롤링 설정
# ==========================================

# SaveTicker 속보 (JSON API) - SAVE 뉴스 탭의 속보
SAVETICKER_ENABLED=true
SAVETICKER_URL=https://saveticker.com/api/news/list?page=1&page_size=20&sort=created_at_desc&label_group=2&label_name=1

# TossInvest 공지사항 (JSON API)
TOSSINVEST_ENABLED=true
TOSSINVEST_URL=https://docs-api.tossinvest.com/api/v1/post/search?categoryId=45&searchTitleKeyword=&page=0&size=10&type=NOTICE

# ==========================================
# 소스별 Discord Webhook (선택사항)
# ==========================================
# 아래를 설정하면 해당 소스는 별도 채널/프로필로 알림이 갑니다.
# 미설정 시 위 DEFAULT_WEBHOOK_URL로 전송됩니다.

# SAVETICKER_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TOSSINVEST_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 기존 DISCORD_WEBHOOK_URL도 호환됩니다 (DEFAULT_WEBHOOK_URL 미설정 시 사용)
# DISCORD_WEBHOOK_URL=

# ==========================================
# ETF 사이트 크롤링 (HTML)
# ==========================================

# Defiance In The News
DEFIANCE_URL=https://www.defianceetfs.com/in-the-news/
DEFIANCE_SELECTOR=.news-item h2 a
DEFIANCE_DATE_SELECTOR=.news-date
DEFIANCE_ENABLED=true

# TRADR News and Media
TRADR_URL=https://www.tradretfs.com/news-and-media
TRADR_SELECTOR=.news-item-title
TRADR_DATE_SELECTOR=.date
TRADR_ENABLED=true

# Leverage Shares In The Press
LEVERAGE_SHARES_URL=https://leverageshares.com/en-eu/in-the-press/
LEVERAGE_SHARES_SELECTOR=.news-item h2 a
LEVERAGE_SHARES_DATE_SELECTOR=.date
LEVERAGE_SHARES_ENABLED=true

# GraniteShares Press
GRANITESHARES_URL=https://graniteshares.com/press/
GRANITESHARES_SELECTOR=.news-article-title
GRANITESHARES_DATE_SELECTOR=.news-article-date
GRANITESHARES_ENABLED=true

# REX Shares News & Insights
TREX_URL=https://www.rexshares.com/news-insights/
TREX_SELECTOR=.blog-single-title
TREX_DATE_SELECTOR=.post-date
TREX_ENABLED=true

# 키워드 필터 (쉼표로 구분, 대소문자 무시)
# 예: launch, etf, list, new, debut, introduced
KEYWORDS=launch,etf,list,new,debut,introduced,listing
