# Discord Bot Token
# https://discord.com/developers/applications 에서 봇 생성 후 토큰 복사
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID (Application ID)
# Discord Developer Portal > General Information 에서 확인
CLIENT_ID=your_discord_client_id_here

# Google AI Studio (Gemini) API Key
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here

# OpenCodeGo API Key (선택사항)
# OpenCodeGo 또는 OpenAI-compatible API 키
OPENCODEGO_API_KEY=your_opencodego_api_key_here

# OpenCodeGo API 엔드포인트 (선택사항)
# OpenAI-compatible 엔드포인트 (예: OpenRouter, OpenCodeGo 등)
OPENCODEGO_API_URL=https://opencode.ai/zen/go/v1/chat/completions

# 기본 AI 제공자 설정 (gemini 또는 opencodego)
DEFAULT_PROVIDER=opencodego

# ==========================================
# 모델 목록 설정 (형식: provider|modelId|표시이름)
# 쉼표(,)로 여러 모델 구분
# provider: gemini 또는 opencodego
# modelId: 실제 API에 사용할 모델 ID
# 표시이름: Discord에서 보여질 이름
# ==========================================
# 아래는 예시 모델들입니다. 실제 사용하려는 모델에 맞게 수정하세요.
# opencodego provider는 OpenAI-compatible API를 사용합니다.
MODELS=opencodego|deepseek-v4-pro|DeepSeek V4 Pro,opencodego|qwen-3.6-plus|Qwen 3.6 Plus,opencodego|glm-5.1|GLM 5.1,opencodego|kimi-k2.6|Kimi K2.6

# 기본 모델 (MODELS 중 하나의 modelId를 입력)
DEFAULT_MODEL=deepseek-v4-pro
